# Server-only. Never prefix these with NEXT_PUBLIC_.
# Copy to .env.local for `next dev`. Do not commit real values.

# TELEMETRY_MODE=development (default) serves labelled sample series from the sanitizer.
# TELEMETRY_MODE=live is reserved; the sanitizer will not proxy Prometheus.
# TELEMETRY_MODE=live

# LAN host allowed to talk to Next.js HMR in `next dev` (no protocol).
# ALLOWED_DEV_ORIGIN=192.168.10.82

# Set to 1 to skip Vercel Analytics in production (recommended on self-host).
# DISABLE_ANALYTICS=1
